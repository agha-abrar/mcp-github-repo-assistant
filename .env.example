# --- GitHub ---
# A GitHub Personal Access Token with read-only scopes (public_repo is enough
# for public repos). Never prefix this with NEXT_PUBLIC_ - it must stay
# server-side only.
GITHUB_TOKEN=

# --- AI provider ---
# Use either OpenAI or OpenRouter credentials.
# For OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override the model used for analysis
OPENAI_MODEL=gpt-4o-mini

# For OpenRouter:
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=gpt-oss-120b
